# DigitalOcean serverless inference. Copy to .env; never commit credentials.
LLM_BASE_URL=https://inference.do-ai.run/v1
# Model selection is verified in docs/digitalocean.md; change only after a tool-call check.
LLM_MODEL=inference-router
# Paste your MODEL ACCESS KEY after = below (not in chat).
GRADIENT_MODEL_ACCESS_KEY=
ANALYSIS_DATE=2026-10-17
LLM_ROUTING_PREFERENCE=budget
