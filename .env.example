# Runtime copilot; these are not the Codex orchestrator/worker settings.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Set in your shell; never commit the actual key.
LLM_API_KEY=
ANALYSIS_DATE=2026-10-16
# Optional; defaults to this project's data/ directory.
# DATA_DIR=/absolute/path/to/runtime-data
# Local Ollama alternative (use an installed model that supports tools):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-installed-model
